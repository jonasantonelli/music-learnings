{
  "name": "music-learnings",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "desktop:dev": "ELECTRON_START_URL=http://localhost:3000 electron .",
    "desktop:build": "node scripts/build-desktop.mjs",
    "desktop:start": "electron .",
    "desktop:dist": "npm run desktop:build && electron-builder"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.2.3",
    "@radix-ui/colors": "^3.0.0",
    "@tailwindcss/typography": "^0.5.19",
    "@types/mdx": "^2.0.13",
    "abcjs": "6.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.8.0",
    "next": "16.2.3",
    "next-themes": "^0.4.6",
    "pagefind": "^1.5.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "description": "Music Learnings — lessons, songs, licks and practice tools.",
  "author": "Jonas Antonelli",
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.musiclearnings.desktop",
    "productName": "Music Learnings",
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "electron/**",
      "package.json",
      "!node_modules/**"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "standalone",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": ".next/standalone/node_modules",
        "to": "standalone/node_modules",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.music",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Audio"
    }
  }
}
